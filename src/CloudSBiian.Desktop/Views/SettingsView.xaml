<UserControl x:Class="CloudSBiian.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CloudSBiian.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Application-wide options. Cache and prediction settings live on their own pages." Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource Banner}" Visibility="{Binding Status, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="rclone" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                               Text="rclone (MIT license) provides the Google Drive, OneDrive, Dropbox, SFTP, S3, SMB and TeraBox backends. Leave the path empty to use the copy bundled with CloudSBiian, the one downloaded with 'Download rclone', or one installed with winget / Scoop / Chocolatey / on PATH. Set a path only to force a specific rclone.exe (e.g. a build that includes a 'terabox' backend). Click Save to apply a changed path." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseRclone}" Margin="8,0,0,8" />
                        <TextBox Text="{Binding RclonePath, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <c:RcloneDependencyPanel DataContext="{Binding Rclone}" />

            <Border Style="{StaticResource Card}">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                        <TextBlock Grid.Row="1" Text="Folder listing cache time (seconds)" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MetadataTtl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Text="Parallel downloads per account" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3" Text="Automatic upload attempts before 'Retry required'" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding UploadAttempts, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="4" Text="Capacity shown when a provider reports no quota (GB)" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding UnknownQuotaGb, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="5" Text="Default folder for Full Local installs" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <DockPanel Grid.Row="5" Grid.Column="1">
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseFullLocal}" Margin="8,0,0,8" />
                            <TextBox Text="{Binding FullLocalDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Grid.Row="6" Text="Log level" VerticalAlignment="Center" Margin="0,0,0,8" />
                        <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" />
                    </Grid>
                    <CheckBox Content="Start CloudSBiian when I sign in to Windows" IsChecked="{Binding StartWithWindows}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10">
                        <Run Text="Data folder: " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save settings" Command="{Binding Save}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Open data folder" Command="{Binding OpenDataFolder}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
