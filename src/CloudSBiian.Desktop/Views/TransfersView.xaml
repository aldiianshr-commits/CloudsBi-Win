<UserControl x:Class="CloudSBiian.Desktop.Views.TransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Width="240" VerticalAlignment="Top" Margin="0,0,12,0" />
                <StackPanel>
                    <TextBlock Text="Transfer Queue" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Active downloads, prefetch and uploads with measured speed, plus every local change waiting to reach the cloud." Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Banner}" Visibility="{Binding Status, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Active transfers" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Nothing is transferring right now." Style="{StaticResource Muted}" Visibility="{Binding Active.Count, Converter={StaticResource Collapsed}}" />
                    <ItemsControl ItemsSource="{Binding Active}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Account}" Style="{StaticResource Muted}" />
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,4,12,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Direction}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Bytes}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Speed}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding Elapsed}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Upload queue" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="States: PendingUpload → Uploading → Synced. RetryRequired and Conflict need your decision; Offline retries automatically." Style="{StaticResource Muted}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueue}" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="130" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90" />
                            <DataGridTemplateColumn Header="State" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding State}" Foreground="{Binding State, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tries" Binding="{Binding Attempts}" Width="55" />
                            <DataGridTextColumn Header="Next / done" Binding="{Binding NextAttempt}" Width="90" />
                            <DataGridTextColumn Header="Last error" Binding="{Binding Error}" Width="240" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Retry" Command="{Binding Retry}" />
                        <Button Content="Retry all" Command="{Binding RetryAll}" />
                        <Button Content="Discard local change" Command="{Binding Discard}" Style="{StaticResource DangerButton}" />
                        <TextBlock Text="Conflict:" VerticalAlignment="Center" Margin="12,0,8,8" Style="{StaticResource Muted}" />
                        <Button Content="Keep mine (overwrite cloud)" Command="{Binding KeepLocal}" />
                        <Button Content="Keep both" Command="{Binding KeepBoth}" />
                        <Button Content="Use cloud version" Command="{Binding DiscardLocal}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Recently finished" Style="{StaticResource SectionTitle}" />
                    <DataGrid ItemsSource="{Binding History}" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80" />
                            <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="130" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Direction}" Width="100" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Outcome}" Width="90" />
                            <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="90" />
                            <DataGridTextColumn Header="Avg speed" Binding="{Binding Speed}" Width="100" />
                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
