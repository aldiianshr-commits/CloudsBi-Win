<UserControl x:Class="CloudSBiian.Desktop.Views.FileBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="File Browser" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Browse an account directly, see what is cached, pin folders and upload or download files." Style="{StaticResource PageSubtitle}" />
            <Grid Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" Margin="0,0,10,8" />
                <Border Grid.Column="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                    <TextBlock Text="{Binding CurrentPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
            <WrapPanel>
                <Button Content="Up" Command="{Binding Up}" />
                <Button Content="Refresh" Command="{Binding Reload}" />
                <Button Content="Open" Command="{Binding Open}" />
                <Button Content="Download…" Command="{Binding Download}" />
                <Button Content="Upload…" Command="{Binding Upload}" />
                <Button Content="New folder" Command="{Binding NewFolder}" />
                <Button Content="Rename" Command="{Binding Rename}" />
                <Button Content="Pin" Command="{Binding Pin}" />
                <Button Content="Unpin" Command="{Binding Unpin}" />
                <Button Content="Remove from cache" Command="{Binding Evict}" />
                <Button Content="Delete" Command="{Binding Delete}" Style="{StaticResource DangerButton}" />
            </WrapPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="6">
            <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MouseDoubleClick="OnDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="110" />
                    <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="160" />
                    <DataGridTextColumn Header="Local state" Binding="{Binding CacheState}" Width="220" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
