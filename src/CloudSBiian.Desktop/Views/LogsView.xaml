<UserControl x:Class="CloudSBiian.Desktop.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Logs &amp; Diagnostics" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Logs never contain passwords or tokens: known secrets and token-shaped values are masked before anything is written." Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Banner}" Visibility="{Binding Status, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </Border>
            <WrapPanel>
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Minimum}" Width="130" Margin="0,0,8,8" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="240" Margin="0,0,8,8" ToolTip="Filter" />
                <CheckBox Content="History (all sessions)" IsChecked="{Binding History}" VerticalAlignment="Center" Margin="0,0,16,8" />
                <Button Content="Refresh" Command="{Binding Reload}" />
                <Button Content="Dependency check" Command="{Binding Check}" />
                <Button Content="Export diagnostics…" Command="{Binding Export}" />
                <Button Content="Open log folder" Command="{Binding OpenFolder}" />
            </WrapPanel>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="6">
            <DataGrid ItemsSource="{Binding Entries}" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="110" />
                    <DataGridTemplateColumn Header="Level" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Level}" Foreground="{Binding Level, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Area" Binding="{Binding Category}" Width="100" />
                    <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="130" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
