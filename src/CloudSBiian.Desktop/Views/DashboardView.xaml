<UserControl x:Class="CloudSBiian.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CloudSBiian.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Live status of drives, accounts, cache and transfers. All numbers are measured; N/A means nothing was measured yet." Style="{StaticResource PageSubtitle}" />

            <WrapPanel>
                <Border Style="{StaticResource Card}" Width="300">
                    <StackPanel>
                        <TextBlock Text="Virtual drive" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding DriveStatus}" Style="{StaticResource Metric}" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding DriveDetail}" Style="{StaticResource Muted}" />
                        <Button Content="Open Virtual Drive" Command="{Binding GoDrive}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="300">
                    <StackPanel>
                        <TextBlock Text="Accounts connected" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding AccountsSummary}" Style="{StaticResource Metric}" Margin="0,6,0,4" />
                        <TextBlock Text="Each account keeps its own session, cache and queue." Style="{StaticResource Muted}" />
                        <Button Content="Manage accounts" Command="{Binding GoAccounts}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="300">
                    <StackPanel>
                        <TextBlock Text="Transfers" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding TransferSummary}" Style="{StaticResource Metric}" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding TransferDetail}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="300">
                    <StackPanel>
                        <TextBlock Text="Cache (physical)" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding CacheSummary}" Style="{StaticResource Metric}" Margin="0,6,0,8" />
                        <ProgressBar Value="{Binding CacheUsage, Mode=OneWay}" Maximum="100" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding CacheDetail}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="300">
                    <StackPanel>
                        <TextBlock Text="Cache hit rate (active reads)" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding HitRate}" Style="{StaticResource Metric}" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding HitDetail}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="300">
                    <StackPanel>
                        <TextBlock Text="Pending uploads" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding PendingUploads}" Style="{StaticResource Metric}" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding PendingDetail}" Style="{StaticResource Muted}" />
                        <Button Content="Transfer queue" Command="{Binding GoTransfers}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="300">
                    <StackPanel>
                        <TextBlock Text="Prefetch accuracy" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding PrefetchSummary}" Style="{StaticResource Metric}" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding PrefetchDetail}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="300">
                    <StackPanel>
                        <TextBlock Text="Read response time (avg)" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Latency}" Style="{StaticResource Metric}" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding LatencyDetail}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Throughput" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Rectangle Width="14" Height="2" Fill="{DynamicResource ChartBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Download" Style="{StaticResource Muted}" Margin="0,0,14,0" />
                            <Rectangle Width="14" Height="2" Fill="{DynamicResource ChartSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Upload" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </DockPanel>
                    <c:Sparkline Height="120" Values="{Binding DownSeries}" SecondaryValues="{Binding UpSeries}"
                                 Stroke="{DynamicResource ChartBrush}" SecondaryStroke="{DynamicResource ChartSecondaryBrush}" GridBrush="{DynamicResource CardBorderBrush}" />
                    <TextBlock Text="{Binding ChartLegend}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TeraBox accounts" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="No TeraBox account added." Style="{StaticResource Muted}"
                                   Visibility="{Binding TeraBoxAccounts.Count, Converter={StaticResource Collapsed}}" />
                        <ItemsControl ItemsSource="{Binding TeraBoxAccounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{Binding State}" DockPanel.Dock="Right" Style="{StaticResource Muted}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Recent warnings and errors" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Nothing to report." Style="{StaticResource Muted}"
                                   Visibility="{Binding RecentProblems.Count, Converter={StaticResource Collapsed}}" />
                        <ItemsControl ItemsSource="{Binding RecentProblems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock>
                                            <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                                            <Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{Binding Level, Converter={StaticResource StatusBrush}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
