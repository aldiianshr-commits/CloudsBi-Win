<Window x:Class="CloudSBiian.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CloudSBiian.Desktop.ViewModels"
        xmlns:v="clr-namespace:CloudSBiian.Desktop.Views"
        Title="CloudSBiian" Height="820" Width="1320" MinWidth="980" MinHeight="620"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="pack://application:,,,/Assets/cloudsbiian.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsViewModel}"><v:AccountsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriveViewModel}"><v:DriveView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileBrowserViewModel}"><v:FileBrowserView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CacheViewModel}"><v:CacheView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PredictionViewModel}"><v:PredictionView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><v:LibraryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransfersViewModel}"><v:TransfersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitoringViewModel}"><v:MonitoringView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}"><v:LogsView /></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,22">
                    <Image Source="pack://application:,,,/Assets/cloudsbiian.ico" Width="30" Height="30" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CloudSBiian" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Cloud drive &amp; game library" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Margin="10,1" Padding="12,9" CornerRadius="6" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="15" Width="26" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="32,26,20,8" Focusable="False" />

        <Border Grid.Column="1" Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="32,8">
            <TextBlock Text="{Binding Footer}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
        </Border>
    </Grid>
</Window>
